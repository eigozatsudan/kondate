# 実値をコミットしない。ユーザーは kondate_ops_readonly の URL のみ。
# direct: postgresql://kondate_ops_readonly:[password]@db.[ref].supabase.co:5432/postgres?sslmode=require
# session pooler: postgresql://kondate_ops_readonly.[20-char-ref]:[password]@aws-0-….pooler.supabase.com:5432/postgres?sslmode=require
ADMIN_DATABASE_URL=
ADMIN_PORT=5193
ADMIN_BIND_HOST=0.0.0.0
# 推奨: 高エントロピー。設定時は API が Bearer を要求する
# ADMIN_LOCAL_TOKEN=
# ローカル Compose DB のみ: ADMIN_ALLOW_INSECURE_LOCAL_DB=1
