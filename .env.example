# Generate real local-only values with ./scripts/generate-local-secrets.sh.
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
AUTH_CONTINUATION_ENCRYPTION_KEY=
GENERATION_REQUEST_HMAC_KEY=generated-32-byte-base64-secret
# identity daily quota HMAC (do not reuse GENERATION_REQUEST_HMAC_KEY)
QUOTA_IDENTITY_HMAC_KEY=generated-32-byte-base64-secret
AUTH_CONTINUATION_TTL_SECONDS=300
SERVER_SITE_ORIGIN=http://127.0.0.1:5173
SITE_URL=http://127.0.0.1:5173
ADDITIONAL_REDIRECT_URLS=http://127.0.0.1:5173/**
API_EXTERNAL_URL=http://127.0.0.1:8000/auth/v1
SUPABASE_PUBLIC_URL=http://127.0.0.1:8000
SMTP_USER=mailpit
SMTP_PASS=mailpit
SMTP_ADMIN_EMAIL=noreply@kondate.local
SMTP_SENDER_NAME=こんだて日和
ENABLE_GOOGLE_SIGNUP=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/v1/callback
OAUTH_MOCK_USER_PASSWORD=
VITE_SUPABASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_MAGIC_LINK_RESEND_SECONDS=60
VITE_AUTH_CONTINUATION_TTL_MS=300000
VITE_AUTH_PROVIDER_MODE=oauth_mock
VITE_OAUTH_MOCK_ORIGIN=http://127.0.0.1:8788
# Local default via compose (deterministic, no real API cost):
# OPENROUTER_BASE_URL=http://openrouter-mock:8787/api/v1
# OPENROUTER_MODELS=mock/kondate-primary:free,mock/kondate-repair:free
# OPENROUTER_PLUS_MODELS=mock/kondate-primary:free,mock/kondate-repair:free
# OPENROUTER_FLYER_MODELS=  # optional; empty → falls back to OPENROUTER_PLUS_MODELS
# Real API: copy an N=10-validated EXACT string from docs/runbooks/openrouter.md only.
# Do not recombine IDs. gpt-5.6-luna-pro is NOT validated (402 risk without max_tokens).
# Example freeze-qualified single model (replace if runbook advances):
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODELS=openai/gpt-5.6-luna
# Plus 品質モード（「くわしく作る」）。BILLING_ENABLED=true 時は必須（1 本以上）。
OPENROUTER_PLUS_MODELS=openai/gpt-5.6-luna
# チラシ vision 専用（任意）。未設定・空なら OPENROUTER_PLUS_MODELS を使う。
# vision + structured_outputs + response_format、かつ prompt+completion ≤ $4.00/1M。
# 例（ゲート合格 exact ID に置換）: openai/gpt-4o-mini
# OPENROUTER_FLYER_MODELS=openai/gpt-4o-mini
USER_DAILY_AI_LIMIT=3
USER_DAILY_EXTERNAL_CALL_LIMIT=6
USER_SHORT_WINDOW_EXTERNAL_CALL_LIMIT=4
USER_SHORT_WINDOW_SECONDS=600
GLOBAL_DAILY_AI_LIMIT=20
OPENROUTER_TIMEOUT_MS=45000
FUNCTION_TOTAL_BUDGET_MS=55000
AI_PROCESSING_STALE_SECONDS=180
# Local-only: disable personal AI daily/short quotas when SERVER_SITE_ORIGIN is 127.0.0.1:5173.
# Production must omit or set false; true on non-local throws at parse.
AI_QUOTA_DISABLED=false
# Billing / Stripe（server only。VITE_STRIPE_* は禁止）
# BILLING_ENABLED=false でも STRIPE_* があれば Webhook は稼働（A3）
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_API_VERSION=2025-02-24.acacia
# STRIPE_MOCK_BASE_URL=  # local exact mock only: http://stripe-mock:8790

# Local-only maintenance login (never copy into Netlify). Generate via generate-local-secrets.
KONDATE_MAINTENANCE_ENV=local
MAINTENANCE_DB_PASSWORD=
SUPABASE_MAINTENANCE_DB_URL=
