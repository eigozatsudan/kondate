# Generate real local-only values with ./scripts/generate-local-secrets.sh.
# This file is a curated template (not every infra secret). The generator also
# writes LOGFLARE_*, REALTIME_*, S3_*, DASHBOARD_*, JWT material, etc. from
# infra/supabase/.env.example — do not copy this file alone into production.

############
# Supabase / Auth stack (local Docker)
############
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
AUTH_CONTINUATION_ENCRYPTION_KEY=
GENERATION_REQUEST_HMAC_KEY=generated-32-byte-base64-secret
# identity daily quota HMAC (do not reuse GENERATION_REQUEST_HMAC_KEY)
QUOTA_IDENTITY_HMAC_KEY=generated-32-byte-base64-secret
AUTH_CONTINUATION_TTL_SECONDS=300
SERVER_SITE_ORIGIN=http://127.0.0.1:5173
SITE_URL=http://127.0.0.1:5173
ADDITIONAL_REDIRECT_URLS=http://127.0.0.1:5173/**
API_EXTERNAL_URL=http://127.0.0.1:8000/auth/v1
SUPABASE_PUBLIC_URL=http://127.0.0.1:8000
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=mailpit
SMTP_PASS=mailpit
SMTP_ADMIN_EMAIL=noreply@kondate.local
SMTP_SENDER_NAME=こんだて日和
ENABLE_GOOGLE_SIGNUP=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/v1/callback
OAUTH_MOCK_USER_PASSWORD=

############
# Browser-safe Vite (only VITE_* below; never VITE_STRIPE_* / VITE_BILLING_*)
############
VITE_SUPABASE_URL=http://127.0.0.1:8000
# Compose maps ANON_KEY → VITE_SUPABASE_PUBLISHABLE_KEY / SUPABASE_PUBLISHABLE_KEY.
# Leave empty here; generate-local-secrets fills ANON_KEY.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_MAGIC_LINK_RESEND_SECONDS=60
VITE_AUTH_CONTINUATION_TTL_MS=300000
VITE_AUTH_PROVIDER_MODE=oauth_mock
VITE_OAUTH_MOCK_ORIGIN=http://127.0.0.1:8788

############
# OpenRouter (Functions). Local default = openrouter-mock (no real API cost).
# compose.yaml defaults match these when vars are unset.
############
OPENROUTER_API_KEY=local-mock-key
OPENROUTER_BASE_URL=http://openrouter-mock:8787/api/v1
OPENROUTER_MODELS=mock/kondate-primary:free,mock/kondate-repair:free
# Plus quality mode. BILLING_ENABLED=true requires ≥1 model. Mock-ok only on exact mock base.
OPENROUTER_PLUS_MODELS=mock/kondate-primary:free,mock/kondate-repair:free
# Flyer vision allowlist (optional). Empty → OPENROUTER_PLUS_MODELS.
OPENROUTER_FLYER_MODELS=
# Release-locked budgets (shared/contracts/function-budget.ts). Netlify sync hard cap 60s.
OPENROUTER_TIMEOUT_MS=24000
FUNCTION_TOTAL_BUDGET_MS=55000
AI_PROCESSING_STALE_SECONDS=180
# Free product locks (runtime Plus limits come from planQuota + entitlement, not these).
USER_DAILY_AI_LIMIT=3
USER_DAILY_EXTERNAL_CALL_LIMIT=6
USER_SHORT_WINDOW_EXTERNAL_CALL_LIMIT=4
USER_SHORT_WINDOW_SECONDS=600
# App-wide safety valve (JST day, all users). Local default 20; production ops often 80.
# Product max is planQuota.globalDailyAiLimitProductMax (500). Raise ops value via ENV only;
# raise product max via that constant + preflight mirror (no SQL). See README.
GLOBAL_DAILY_AI_LIMIT=20
# Personal quota off only when SERVER_SITE_ORIGIN is 127.0.0.1:5173. Production must be false/omit.
AI_QUOTA_DISABLED=false

# Real OpenRouter (optional override — costs money). N=10-validated EXACT IDs only.
# Do not recombine. See docs/runbooks/openrouter.md.
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODELS=openai/gpt-5.6-luna
# OPENROUTER_PLUS_MODELS=openai/gpt-5.6-luna
# OPENROUTER_FLYER_MODELS=openai/gpt-4o-mini

############
# Billing / Stripe (server only). Never VITE_STRIPE_* / VITE_BILLING_*.
# BILLING_ENABLED=false still runs Webhook if STRIPE_* keys are present (A3).
############
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_API_VERSION=2026-06-24.dahlia
# Local exact mock only (http://stripe-mock:8790). Setting this in production fails parse.
STRIPE_MOCK_BASE_URL=

############
# Host / Compose identity (generate-local-secrets fills these)
############
LOCAL_UID=1000
LOCAL_GID=1000
# Set by tooling wrappers (kondate-<32 hex>). Do not invent by hand for multi-checkout.
# KONDATE_COMPOSE_PROJECT_NAME=

############
# Maintenance login (local only — never copy into Netlify)
############
KONDATE_MAINTENANCE_ENV=local
MAINTENANCE_DB_PASSWORD=
SUPABASE_MAINTENANCE_DB_URL=
# maintenance-cleanup アプリ層 secret（16文字以上）。local invoke は
# header x-maintenance-cron-secret に同じ値を載せる。本番も Netlify secret として必須。
MAINTENANCE_CRON_SECRET=
# share-generalize-worker アプリ層 secret（16文字以上）。local invoke は
# header x-share-worker-cron-secret に同じ値を載せる。本番も Netlify secret として必須。
SHARE_WORKER_CRON_SECRET=
