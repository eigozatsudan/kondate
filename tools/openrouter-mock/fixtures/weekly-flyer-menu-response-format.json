{
  "type": "json_schema",
  "json_schema": {
    "name": "kondate_weekly_flyer_menu",
    "strict": true,
    "schema": {
      "type": "object",
      "properties": {
        "days": {
          "minItems": 7,
          "maxItems": 7,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dayIndex": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              },
              "mainName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "sideName": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ingredients": {
                "minItems": 1,
                "maxItems": 30,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "notes": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 300
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": ["dayIndex", "label", "mainName", "sideName", "ingredients", "notes"],
            "additionalProperties": false
          }
        }
      },
      "required": ["days"],
      "additionalProperties": false
    }
  }
}
